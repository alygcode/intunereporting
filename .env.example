# ============================================================================
# Microsoft Graph API Authentication Configuration
# ============================================================================

# Azure AD / Entra ID Configuration
# Required for authenticating with Microsoft Graph API

# Your Azure AD Tenant ID
# Get from: Azure Portal > App registrations > Your App > Overview
AZURE_TENANT_ID=your-tenant-id-here

# Application (Client) ID from Azure AD App Registration
# Get from: Azure Portal > App registrations > Your App > Overview
AZURE_CLIENT_ID=your-client-id-here

# Client Secret from Azure AD App Registration (for client credentials flow)
# Get from: Azure Portal > App registrations > Your App > Certificates & secrets
AZURE_CLIENT_SECRET=your-client-secret-here

# ============================================================================
# Optional: Certificate-Based Authentication
# ============================================================================
# Alternative to client secret for enhanced security in production

# Path to certificate file
# CERTIFICATE_PATH=/path/to/certificate.pem

# Certificate thumbprint
# CERTIFICATE_THUMBPRINT=your-cert-thumbprint-here

# ============================================================================
# Optional: Multi-Tenant Configuration
# ============================================================================
# For applications that work with multiple Azure AD tenants

# Production Tenant
# PROD_CLIENT_ID=prod-client-id
# PROD_CLIENT_SECRET=prod-secret
# PROD_TENANT_ID=prod-tenant-id

# Staging Tenant
# STAGING_CLIENT_ID=staging-client-id
# STAGING_CLIENT_SECRET=staging-secret
# STAGING_TENANT_ID=staging-tenant-id

# Development Tenant
# DEV_CLIENT_ID=dev-client-id
# DEV_CLIENT_SECRET=dev-secret
# DEV_TENANT_ID=dev-tenant-id

# ============================================================================
# Optional: Token Cache Configuration
# ============================================================================

# Custom location for token cache file
# Default: ~/.graph-auth-cache.json
# TOKEN_CACHE_LOCATION=./cache/.graph-tokens.json

# Enable/disable token caching (default: true)
# CACHE_ENABLED=true

# ============================================================================
# Optional: Graph API Scopes
# ============================================================================

# Default scopes for client credentials flow
GRAPH_SCOPES=https://graph.microsoft.com/.default

# User delegated scopes (for device code / interactive authentication)
# USER_SCOPES=User.Read,User.ReadBasic.All,Directory.Read.All

# Intune-specific scopes
# INTUNE_SCOPES=DeviceManagementManagedDevices.Read.All,DeviceManagementConfiguration.Read.All

# ============================================================================
# Optional: Authentication Flow Settings
# ============================================================================

# Device code flow timeout (milliseconds, default: 300000 = 5 minutes)
# DEVICE_CODE_TIMEOUT=300000

# Interactive auth redirect URI (default: http://localhost)
# REDIRECT_URI=http://localhost:3000

# ============================================================================
# Optional: Logging Configuration
# ============================================================================

# Log level for MSAL authentication: Error, Warning, Info, Verbose
# LOG_LEVEL=Info

# ============================================================================
# Optional: Report Configuration
# ============================================================================

# Output directory for reports (default: ./reports)
# REPORT_OUTPUT_DIR=./reports

# Maximum retry attempts for API calls (default: 3)
# MAX_RETRIES=3

# Retry delay in milliseconds (default: 1000)
# RETRY_DELAY=1000
